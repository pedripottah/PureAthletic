  "principles": [
    {
      "id": "play-led-foundation",
      "summary": "For U5-U8, keep instructions short and use enjoyable play, frequent ball contact, exploration, and simple repetition.",
      "sourceIds": ["fifa-play-practice-play-4-8", "fifa-ball-control-4-8", "tcm-age-philosophy"]
    },
    {
      "id": "small-sided-problem-solving",
      "summary": "For U9-U12, use high-involvement game-like tasks, simple numerical problems, role rotation, and sufficient recovery.",
      "sourceIds": ["fifa-numeric-progression-8-12", "football-dna-age-courses"]
    },
    {
      "id": "progressive-game-application",
      "summary": "For U13-U15, move from technical confidence to guided tactical decisions and then game application.",
      "sourceIds": ["fifa-progressive-method-12-15", "fifa-warmups-12-15"]
    },
    {
      "id": "compact-athletic-development",
      "summary": "For U16-U17, add short supervised mobility, core, unilateral strength, acceleration, and deceleration work that complements football.",
      "sourceIds": ["fifa-youth-strength-2026", "fifa-youth-mobility-strength-2026", "aap-youth-resistance-2020"]
    },
    {
      "id": "age-goal-level-filtering",
      "summary": "Every recommendation must be filtered by age band, primary goal, experience, equipment, space, supervision, and schedule before ranking.",
      "sourceIds": ["easy2coach-age-filtering", "easy2coach-session-structure", "tcm-age-curricula"]
    }
  ]
